    "postinstall": "pnpm run gen:theme-typings",
    "vercel-build": "pnpm run build && pnpm trigger-e2e-smoke",
    "vercel-fast-build": "pnpm run build",
    "codegen": "graphql-codegen"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
