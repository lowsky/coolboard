    "react-apollo-network-status": "6.0.0",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.4",
    "react-icons": "5.6.0",
    "react-is": "19.2.4",
    "react-timeago": "8.3.0"
