  "scripts": {
    "dev": "echo you wanna run:  yarn start  instead; yarn start",
    "start": "next dev",
    "start:comment": "next dev ; # not with await+browser-otel: --turbo",
    "start-production": "next start",
    "lint": "eslint",
    "trigger-e2e-smoke": "sh trigger-circleci-smoke.sh",
    "smoketest": "cd smoketest; yarn --immutable ; yarn cy open --e2e -b electron",
    "build": "yarn run metainfo && yarn run prisma:generate && next build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "DATABASE_URL=\"$MIGRATE_DATABASE_URL\" prisma migrate deploy",
    "metainfo": "sh storeMetaInfo.sh",
    "gen:theme-typings": "npx -y @chakra-ui/cli typegen src/common/theme.ts",
    "postinstall": "npm run gen:theme-typings",
    "vercel-build": "yarn run build && yarn trigger-e2e-smoke",
    "vercel-fast-build": "yarn run build",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.3",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "6.2.1",
    "@graphql-codegen/introspection": "5.0.1",
    "@graphql-codegen/schema-ast": "5.0.1",
    "@graphql-codegen/typescript": "5.0.9",
    "@graphql-codegen/typescript-graphql-files-modules": "4.0.0",
    "@graphql-codegen/typescript-operations": "5.0.9",
    "@graphql-codegen/typescript-react-apollo": "4.4.1",
    "@next/eslint-plugin-next": "16.2.2",
    "@parcel/watcher": "2.5.6",
    "@types/react": "19.2.14",
    "@types/react-timeago": "8.0.0",
    "@types/ws": "8.18.1",
    "@types/zen-observable": "0.8.7",
    "@typescript-eslint/parser": "8.57.1",
    "eslint": "10.1.0",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.8.1",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "packageManager": "yarn@4.13.0"
