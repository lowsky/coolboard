  "scripts": {
    "dev": "pnpm start",
    "start": "next dev",
    "start:comment": "next dev",
    "start-production": "next start",
    "lint": "eslint src app server ",
    "trigger-e2e-smoke": "sh trigger-circleci-smoke.sh",
