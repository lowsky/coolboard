{
  "autoApprove": true,
  "automergeStrategy": "squash",

  "packageRules": [
    {
      "vulnerabilityAlerts": {
        "labels": ["security"],
        "automerge": true
      }
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "includePaths": [
    "package.json",
    ".circleci/config.yml",
    ".github/workflows/cleanup-neon-preview.yml",
    "smoketest/package.json",
    ".nvmrc"
  ],
  "dependencyDashboard": true,
  "rebaseWhen": "never",
  "extends": [
    ":separateMultipleMajorReleases",
    ":pinDevDependencies",
    "config:best-practices",
    "config:recommended"
  ]
}
