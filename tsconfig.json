{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "allowJs": false,
    "paths": {
      "auth/*": [
        "src/auth/*"
      ],
      "components/*": [
        "src/components/*"
      ],
      "common/*": [
        "src/common/*"
      ],
      "generated/*": [
        "src/generated/*"
      ]
    },
    "esModuleInterop": true,
    "paths": {
      "src/*": ["./src/*"],
      "server/*": ["./server/*"],
      "generated/*": ["./src/generated/*"],
      "components/*": ["./src/components/*"],
      "common/*": ["./src/common/*"],
      "auth/*": ["./src/auth/*"],
      "public/*": ["./public/*"],
      ".next/*": ["./.next/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "exclude": [
    "server/stuff",
    "node_modules"
  ],
  "include": [
    "next-env.d.ts",
    "netlify/**/*.ts",
    "src/**/*.ts*",
    "pages/**/*.ts*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
